<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0hgggk8" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_04dl048">
    <bpmn:participant id="Participant_0634rqs" name="Food Marketplace" processRef="payment_confirmation" />
  </bpmn:collaboration>
  <bpmn:process id="payment_confirmation" name="Payment Processing &#38; Order Confirmation" isExecutable="true">
    <bpmn:laneSet id="LaneSet_0hm2utn">
      <bpmn:lane id="Lane_0xi7jd6" name="Customer Interaction">
        <bpmn:flowNodeRef>Activity_1yz9qu9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1ypnqu1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_04o3zkx" name="Order &#38; Payment&#10;Managment">
        <bpmn:flowNodeRef>Gateway_1vqt99b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0nmto3c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1kfbcll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_099651w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_05t3uwq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1m93g18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1aomiw8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0404ota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0kwx2ev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0756fev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1gfcugz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0lstjcv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0oz7sp0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1f56vo7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_02nmnay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1tsppbe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_03x9wfi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0nb2sbd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1q74d1s" name="Marketplace Adminstrator">
        <bpmn:flowNodeRef>Event_1obrnt8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1xzueen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="Gateway_1vqt99b" name="Retries left?" default="Flow_1l33dcd">
      <bpmn:incoming>Flow_0k6nyd8</bpmn:incoming>
      <bpmn:outgoing>Flow_1r76d0a</bpmn:outgoing>
      <bpmn:outgoing>Flow_1l33dcd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0nmto3c" default="Flow_11ocjak">
      <bpmn:incoming>Flow_0k2blh1</bpmn:incoming>
      <bpmn:outgoing>Flow_0opnlb7</bpmn:outgoing>
      <bpmn:outgoing>Flow_0qry25b</bpmn:outgoing>
      <bpmn:outgoing>Flow_11ocjak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Activity_1kfbcll" name="Record declined attempt">
      <bpmn:extensionElements>
        <zeebe:script expression="={declines: retryCounters.declines + 1, unavailable: retryCounters.unavailable}" resultVariable="retryCounters" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0opnlb7</bpmn:incoming>
      <bpmn:outgoing>Flow_01ds4vb</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_099651w" name="Build Order Confimation">
      <bpmn:extensionElements>
        <zeebe:script expression="={orderId: orderId, status: &#34;CONFIRMED&#34;, paymentReference: &#34;SIM-&#34; + orderId, totalCommission: totalCommission}" resultVariable="orderConfirmation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0qry25b</bpmn:incoming>
      <bpmn:outgoing>Flow_1ojy698</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_05t3uwq" name="Update inventory">
      <bpmn:extensionElements>
        <zeebe:script expression="=flatten(for p in producerOrders return p.items)" resultVariable="inventoryUpdate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ojy698</bpmn:incoming>
      <bpmn:outgoing>Flow_1u67brz</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_1obrnt8" name="Order on hold – manual follow-up.">
      <bpmn:incoming>Flow_0xzlvvs</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_1xzueen" name="Manual follow-up">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1l33dcd</bpmn:incoming>
      <bpmn:outgoing>Flow_0xzlvvs</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_1m93g18" name="Record unavailable attempt">
      <bpmn:extensionElements>
        <zeebe:script expression="={declines: retryCounters.declines, unavailable: retryCounters.unavailable + 1}" resultVariable="retryCounters" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11ocjak</bpmn:incoming>
      <bpmn:outgoing>Flow_0k6nyd8</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_1aomiw8" name="Declines left?" default="Flow_1fsav1f">
      <bpmn:incoming>Flow_01ds4vb</bpmn:incoming>
      <bpmn:outgoing>Flow_1g7or7s</bpmn:outgoing>
      <bpmn:outgoing>Flow_1fsav1f</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Activity_0404ota" name="Notify producers">
      <bpmn:extensionElements>
        <zeebe:script expression="={producerId: allocation.producerId, producerName: allocation.producerName, message: &#34;New paid order &#34; + orderId + &#34;. You will receive £&#34; + string(allocation.net), status: &#34;SENT&#34;}" resultVariable="notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1u67brz</bpmn:incoming>
      <bpmn:outgoing>Flow_0xotojz</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=allocations" inputElement="allocation" outputCollection="producerNotifications" outputElement="=notification" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_0kwx2ev" name="Order cancelled, too many declines">
      <bpmn:incoming>Flow_1fsav1f</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_0756fev" name="Customer Choice" default="Flow_0dfy7ob">
      <bpmn:incoming>Flow_1670k36</bpmn:incoming>
      <bpmn:outgoing>Flow_0xcno2b</bpmn:outgoing>
      <bpmn:outgoing>Flow_0dfy7ob</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1gfcugz" name="Order cancelled by customer">
      <bpmn:incoming>Flow_0dfy7ob</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Activity_0lstjcv" name="Send customer confirmation">
      <bpmn:extensionElements>
        <zeebe:script expression="={to: customerEmail, message: &#34;Order &#34; + orderId + &#34; confirmed. Total £&#34; + string(totalAmount), status: &#34;SENT&#34;}" resultVariable="customerNotification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0xotojz</bpmn:incoming>
      <bpmn:outgoing>Flow_1vwk47a</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0k6nyd8" sourceRef="Activity_1m93g18" targetRef="Gateway_1vqt99b" />
    <bpmn:sequenceFlow id="Flow_1r76d0a" name="Yes" sourceRef="Gateway_1vqt99b" targetRef="Event_0oz7sp0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryCounters.unavailable &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1l33dcd" name="No" sourceRef="Gateway_1vqt99b" targetRef="Activity_1xzueen" />
    <bpmn:sequenceFlow id="Flow_0xcno2b" name="Retry" sourceRef="Gateway_0756fev" targetRef="Activity_1ypnqu1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryChoice = "RETRY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1670k36" sourceRef="Activity_1yz9qu9" targetRef="Gateway_0756fev" />
    <bpmn:sequenceFlow id="Flow_0mhxihu" sourceRef="StartEvent_1" targetRef="Activity_02nmnay" />
    <bpmn:sequenceFlow id="Flow_05kh2rh" sourceRef="Activity_02nmnay" targetRef="Activity_1tsppbe" />
    <bpmn:sequenceFlow id="Flow_133wmrv" sourceRef="Event_0oz7sp0" targetRef="Activity_0nb2sbd" />
    <bpmn:sequenceFlow id="Flow_0k2blh1" name="Payment result?" sourceRef="Activity_0nb2sbd" targetRef="Gateway_0nmto3c" />
    <bpmn:sequenceFlow id="Flow_0opnlb7" name="Declined" sourceRef="Gateway_0nmto3c" targetRef="Activity_1kfbcll">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "DECLINED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0qry25b" name="Success" sourceRef="Gateway_0nmto3c" targetRef="Activity_099651w">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "SUCCESS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11ocjak" sourceRef="Gateway_0nmto3c" targetRef="Activity_1m93g18" />
    <bpmn:sequenceFlow id="Flow_01ds4vb" sourceRef="Activity_1kfbcll" targetRef="Gateway_1aomiw8" />
    <bpmn:sequenceFlow id="Flow_1ojy698" sourceRef="Activity_099651w" targetRef="Activity_05t3uwq" />
    <bpmn:sequenceFlow id="Flow_1g7or7s" name="Yes" sourceRef="Gateway_1aomiw8" targetRef="Activity_1yz9qu9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryCounters.declines &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1u67brz" sourceRef="Activity_05t3uwq" targetRef="Activity_0404ota" />
    <bpmn:sequenceFlow id="Flow_0xzlvvs" sourceRef="Activity_1xzueen" targetRef="Event_1obrnt8" />
    <bpmn:sequenceFlow id="Flow_1fsav1f" name="No" sourceRef="Gateway_1aomiw8" targetRef="Event_0kwx2ev" />
    <bpmn:sequenceFlow id="Flow_0xotojz" sourceRef="Activity_0404ota" targetRef="Activity_0lstjcv" />
    <bpmn:sequenceFlow id="Flow_0dfy7ob" sourceRef="Gateway_0756fev" targetRef="Event_1gfcugz" />
    <bpmn:intermediateCatchEvent id="Event_0oz7sp0" name="Wait before retry">
      <bpmn:incoming>Flow_1r76d0a</bpmn:incoming>
      <bpmn:outgoing>Flow_133wmrv</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_01dmn9c">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_1f56vo7" name="Order Confirmed">
      <bpmn:incoming>Flow_1vwk47a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1vwk47a" sourceRef="Activity_0lstjcv" targetRef="Event_1f56vo7" />
    <bpmn:startEvent id="StartEvent_1" name="Validated order received">
      <bpmn:outgoing>Flow_0mhxihu</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Activity_02nmnay" name="Initialise payment counters">
      <bpmn:extensionElements>
        <zeebe:script expression="={declines: 0, unavailable: 0}" resultVariable="retryCounters" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0mhxihu</bpmn:incoming>
      <bpmn:outgoing>Flow_05kh2rh</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_1tsppbe" name="Calculate allocation">
      <bpmn:extensionElements>
        <zeebe:script expression="=for p in producerOrders return {&#10;   producerId: p.producerId,&#10;  producerName: p.producerName,&#10;  gross: p.subtotal,&#10;  commission: round half up(p.subtotal * 0.05, 2),&#10;  net: p.subtotal - round half up(p.subtotal * 0.05, 2)&#10;}" resultVariable="allocations" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05kh2rh</bpmn:incoming>
      <bpmn:outgoing>Flow_1ylwgkk</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Activity_1yz9qu9" name="Retry or cancel payment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="retry_decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1g7or7s</bpmn:incoming>
      <bpmn:outgoing>Flow_1670k36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_1ypnqu1" name="Enter payment details">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="payment_details" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0xcno2b</bpmn:incoming>
      <bpmn:incoming>Flow_0e7zboe</bpmn:incoming>
      <bpmn:outgoing>Flow_1sifftz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_03x9wfi" name="Calculate total commission">
      <bpmn:extensionElements>
        <zeebe:script expression="=sum(allocations.commission)" resultVariable="totalCommission" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ylwgkk</bpmn:incoming>
      <bpmn:outgoing>Flow_0e7zboe</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_0nb2sbd" name="Payment">
      <bpmn:extensionElements>
        <zeebe:script expression="=if replace(cardNumber, &#34;[ -]&#34;, &#34;&#34;) = &#34;4242424242424242&#34; then &#34;SUCCESS&#34;&#10;else if replace(cardNumber, &#34;[ -]&#34;, &#34;&#34;) = &#34;4000000000000002&#34; then &#34;DECLINED&#34;&#10;else &#34;UNAVAILABLE&#34;" resultVariable="paymentStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_133wmrv</bpmn:incoming>
      <bpmn:incoming>Flow_1sifftz</bpmn:incoming>
      <bpmn:outgoing>Flow_0k2blh1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1ylwgkk" sourceRef="Activity_1tsppbe" targetRef="Activity_03x9wfi" />
    <bpmn:sequenceFlow id="Flow_0e7zboe" sourceRef="Activity_03x9wfi" targetRef="Activity_1ypnqu1" />
    <bpmn:sequenceFlow id="Flow_1sifftz" sourceRef="Activity_1ypnqu1" targetRef="Activity_0nb2sbd" />
  </bpmn:process>
