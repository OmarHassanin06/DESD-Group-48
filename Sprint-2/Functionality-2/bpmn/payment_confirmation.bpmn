<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0hgggk8" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="payment_confirmation" name="Payment Processing &#38; Order Confirmation" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Validated order received">
      <bpmn:outgoing>Flow_0mhxihu</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0mhxihu" sourceRef="StartEvent_1" targetRef="Activity_02nmnay" />
    <bpmn:scriptTask id="Activity_1tsppbe" name="Calculate allocations &#38; commission">
      <bpmn:extensionElements>
        <zeebe:script expression="=for p in producerOrders return {&#10;   producerId: p.producerId,&#10;  producerName: p.producerName,&#10;  gross: p.subtotal,&#10;  commission: round half up(p.subtotal * 0.05, 2),&#10;  net: p.subtotal - round half up(p.subtotal * 0.05, 2)&#10;}" resultVariable="allocations" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05kh2rh</bpmn:incoming>
      <bpmn:outgoing>Flow_07ct2pc</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_03x9wfi" name="Calculate total commission">
      <bpmn:extensionElements>
        <zeebe:script expression="=sum(allocations.commission)" resultVariable="totalCommission" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07ct2pc</bpmn:incoming>
      <bpmn:outgoing>Flow_1mrprxf</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_07ct2pc" sourceRef="Activity_1tsppbe" targetRef="Activity_03x9wfi" />
    <bpmn:sequenceFlow id="Flow_1mrprxf" sourceRef="Activity_03x9wfi" targetRef="Activity_1ypnqu1" />
    <bpmn:userTask id="Activity_1ypnqu1" name="Enter payment details">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="payment_details" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1mrprxf</bpmn:incoming>
      <bpmn:incoming>Flow_0xcno2b</bpmn:incoming>
      <bpmn:outgoing>Flow_0y4odkp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0y4odkp" sourceRef="Activity_1ypnqu1" targetRef="Activity_0nb2sbd" />
    <bpmn:scriptTask id="Activity_0nb2sbd" name="Simulate Payment">
      <bpmn:extensionElements>
        <zeebe:script expression="=if replace(cardNumber, &#34;[ -]&#34;, &#34;&#34;) = &#34;4242424242424242&#34; then &#34;SUCCESS&#34;&#10;else if replace(cardNumber, &#34;[ -]&#34;, &#34;&#34;) = &#34;4000000000000002&#34; then &#34;DECLINED&#34;&#10;else &#34;UNAVAILABLE&#34;" resultVariable="paymentStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0y4odkp</bpmn:incoming>
      <bpmn:outgoing>Flow_0k2blh1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_0nmto3c" name="Payment Result?" default="Flow_1ub6m3o">
      <bpmn:incoming>Flow_0k2blh1</bpmn:incoming>
      <bpmn:outgoing>Flow_1jb7m3i</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ub6m3o</bpmn:outgoing>
      <bpmn:outgoing>Flow_0opnlb7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0k2blh1" sourceRef="Activity_0nb2sbd" targetRef="Gateway_0nmto3c" />
    <bpmn:endEvent id="Event_1tb4xl6" name="Success">
      <bpmn:incoming>Flow_1jb7m3i</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1jb7m3i" sourceRef="Gateway_0nmto3c" targetRef="Event_1tb4xl6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=	paymentStatus = "SUCCESS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_17b8ugr" name="Unavailable">
      <bpmn:incoming>Flow_1ub6m3o</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1ub6m3o" sourceRef="Gateway_0nmto3c" targetRef="Event_17b8ugr" />
    <bpmn:sequenceFlow id="Flow_05kh2rh" sourceRef="Activity_02nmnay" targetRef="Activity_1tsppbe" />
    <bpmn:scriptTask id="Activity_02nmnay" name="Initialise payment counters">
      <bpmn:extensionElements>
        <zeebe:script expression="={declines: 0, unavailable: 0}" resultVariable="retryCounters" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0mhxihu</bpmn:incoming>
      <bpmn:outgoing>Flow_05kh2rh</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0opnlb7" name="Declined" sourceRef="Gateway_0nmto3c" targetRef="Activity_1kfbcll">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "DECLINED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:scriptTask id="Activity_1kfbcll" name="Record declined attempt">
      <bpmn:extensionElements>
        <zeebe:script expression="={declines: retryCounters.declines + 1, unavailable: retryCounters.unavailable}" resultVariable="retryCounters" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0opnlb7</bpmn:incoming>
      <bpmn:outgoing>Flow_01ds4vb</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_1aomiw8" name="Attempts left?" default="Flow_1fsav1f">
      <bpmn:incoming>Flow_01ds4vb</bpmn:incoming>
      <bpmn:outgoing>Flow_1g7or7s</bpmn:outgoing>
      <bpmn:outgoing>Flow_1fsav1f</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_01ds4vb" sourceRef="Activity_1kfbcll" targetRef="Gateway_1aomiw8" />
    <bpmn:sequenceFlow id="Flow_1g7or7s" name="Yes" sourceRef="Gateway_1aomiw8" targetRef="Activity_1yz9qu9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryCounters.declines &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_1yz9qu9" name="Retry or cancel payment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="retry_decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1g7or7s</bpmn:incoming>
      <bpmn:outgoing>Flow_1670k36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_0kwx2ev" name="Order cancelled, too many declines">
      <bpmn:incoming>Flow_1fsav1f</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1fsav1f" name="No" sourceRef="Gateway_1aomiw8" targetRef="Event_0kwx2ev" />
    <bpmn:exclusiveGateway id="Gateway_0756fev" name="Customer Choice" default="Flow_0dfy7ob">
      <bpmn:incoming>Flow_1670k36</bpmn:incoming>
      <bpmn:outgoing>Flow_0xcno2b</bpmn:outgoing>
      <bpmn:outgoing>Flow_0dfy7ob</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1670k36" sourceRef="Activity_1yz9qu9" targetRef="Gateway_0756fev" />
    <bpmn:sequenceFlow id="Flow_0xcno2b" name="Retry" sourceRef="Gateway_0756fev" targetRef="Activity_1ypnqu1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retryChoice = "RETRY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_1gfcugz" name="Order cancelled by customer">
      <bpmn:incoming>Flow_0dfy7ob</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0dfy7ob" sourceRef="Gateway_0756fev" targetRef="Event_1gfcugz" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
